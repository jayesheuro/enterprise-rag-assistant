# ==============================================================================
# Environment Configuration for Enterprise RAG Assistant
#
# Copy this file to .env and customize for your local setup:
#   cp .env.example .env
#
# NOTE: .env contains secrets and local overrides — NEVER commit it to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & Embedder Provider Credentials
# ------------------------------------------------------------------------------

# Google Gemini API key (Required if configs/app.yaml sets provider: gemini)
# Obtain a free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# AWS Bedrock Credentials (Optional, only needed if configs/app.yaml sets provider: bedrock)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# 2. Frontend / Streamlit UI Configuration
# ------------------------------------------------------------------------------

# URL of the running FastAPI backend service
# Default: http://localhost:8000
BACKEND_URL=http://localhost:8000

# Demo Mode: locks mutating actions (disables document upload/ingestion)
# and limits chat queries to 10 per session to protect public demo quota.
# Options: false (default, full access) | true (read-only showcase)
DEMO_MODE=false

# Client-side HTTP request timeout in seconds for backend communication
# Accommodates multi-stage pipelines (retrieval + LLM reranking + generation)
# Default: 180.0
API_TIMEOUT=180.0

# ------------------------------------------------------------------------------
# 3. Experiment Tracking & MLflow (Optional)
# ------------------------------------------------------------------------------

# MLflow tracking server URI (configured in configs/app.yaml as sqlite:///mlflow.db)
# Override here if connecting to a remote MLflow server:
# MLFLOW_TRACKING_URI=http://localhost:5000

# ------------------------------------------------------------------------------
# 4. Demo Quota (Phase 7 — HF Spaces public deployment)
# ------------------------------------------------------------------------------

# Global daily query cap across ALL sessions (resets at UTC midnight).
# Protects Gemini free-tier quota on the public demo.
# Set as a public env var in Hugging Face Spaces — not a secret.
# Default: 50
DEMO_DAILY_CAP=50

# Path to the quota counter file. /tmp is fine; it's ephemeral per container
# restart (which also resets LanceDB, so a full re-seed anyway).
# Default: /tmp/daily_quota.json
QUOTA_FILE_PATH=/tmp/daily_quota.json

